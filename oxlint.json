{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "error",
    "no-console": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-implicit-coercion": "error",
    "no-param-reassign": "error",
    "no-nested-ternary": "warn"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "*.config.ts",
    "*.config.js",
    ".storybook/**"
  ]
}
