{
  "name": "formulaq",
  "version": "0.1.0",
  "description": "Extensible formula engine for React applications",
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./playground": {
      "types": "./dist/playground/index.d.ts",
      "import": "./dist/playground/index.js"
    },
    "./datagrid": {
      "types": "./dist/datagrid/index.d.ts",
      "import": "./dist/datagrid/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "pnpm build:grammar && tsc && vite build",
    "build:grammar": "lezer-generator src/editor/codemirror/formula.grammar -o src/editor/codemirror/parser.js",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "check:style": "oxfmt --check src/",
    "check:lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "vitest bench",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/x-data-grid": "^8.0.0",
    "chevrotain": "^11.0.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.0",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/common": "^1.5.0",
    "@lezer/generator": "^1.7.2",
    "@lezer/highlight": "^1.2.1",
    "@lezer/lr": "^1.4.2",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/addon-onboarding": "^8.6.0",
    "@storybook/blocks": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^8.6.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropics/formulaq"
  },
  "keywords": [
    "formula",
    "expression",
    "parser",
    "evaluator",
    "react",
    "datagrid"
  ]
}
